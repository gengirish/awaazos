    "test:golden:validate": "vitest run tests/golden/parse-order/validate.test.ts",
    "test:golden:drop": "vitest run tests/golden/parse-drop/live.test.ts",
    "test:golden:drop:validate": "vitest run tests/golden/parse-drop/validate.test.ts",
    "test:golden:menu": "vitest run tests/golden/parse-menu/live.test.ts",
    "test:golden:menu:validate": "vitest run tests/golden/parse-menu/validate.test.ts",
    "test:golden:stt": "vitest run tests/golden/stt/live.test.ts",
    "test:golden:stt:validate": "vitest run tests/golden/stt/validate.test.ts",
    "test:drops:db": "node -e \"process.env.DROPS_DB_TEST='1';process.exit(require('child_process').spawnSync('npx vitest run --no-file-parallelism lib/__tests__/drops.db.test.ts lib/__tests__/drop-open-publish.db.test.ts lib/__tests__/menu-orders.db.test.ts lib/__tests__/menu-visibility.db.test.ts lib/__tests__/everyday-menu-control.db.test.ts lib/__tests__/storefront-orders.db.test.ts lib/__tests__/push.db.test.ts lib/__tests__/push-routes.db.test.ts lib/__tests__/payment-guard.db.test.ts lib/__tests__/menu-bulk.db.test.ts lib/__tests__/subscription-webhook.db.test.ts lib/__tests__/subscription-verify.db.test.ts lib/__tests__/offers.db.test.ts lib/__tests__/admin-free-access.db.test.ts lib/__tests__/demo-stores.db.test.ts lib/__tests__/admin-store-insights.db.test.ts',{stdio:'inherit',shell:true}).status ?? 1)\"",
    "perf:budget": "node scripts/check-bundle-budget.mjs",
    "perf:lighthouse": "node scripts/perf-lighthouse.mjs",
    "precommit:checks": "lint-staged",
    "prepare": "husky"
  },
