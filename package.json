    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.3.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@sentry/nextjs": "^10.50.0",
    "@sentry/node": "^10.50.0",
    "@upstash/redis": "^1.37.0",
    "@vercel/blob": "^2.8.1",
    "@vercel/functions": "^3.9.11",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "ioredis": "^5.4.2",
    "libphonenumber-js": "^1.11.18",
    "lucide-react": "^0.469.0",
    "next": "^15.5.27",
    "next-auth": "5.0.0-beta.32",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^15.5.27",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.49",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "deepmerge-ts": "^8.0.2",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    }
  }
}
