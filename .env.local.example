# AwaazOS env template — copy to .env.local and fill in REAL values.
# .env.local is gitignored. NEVER commit real secrets.

# ─── Database (Neon serverless Postgres) ──────────────────────────────
# DATABASE_URL = pooled connection (host contains '-pooler') for app runtime
# DIRECT_URL   = direct connection (no '-pooler') for `prisma db push` (no migrations in this repo)
# Get both from the Neon console → Connection Details → Show password.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"

# ─── Auth.js v5 ───────────────────────────────────────────────────────
# Generate AUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Public origin of this deployment. Optional at boot, but set it in EVERY environment:
# locally to http://localhost:3000, and on Vercel to the production origin. Auth.js uses it
# for callback URLs, and it is the first choice for emailed links (see NEXT_PUBLIC_APP_URL below).
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true                    # trust the proxy's Host header (needed on Vercel)

# ─── Anthropic (Haiku 4.5 primary, Sonnet 4.5 fallback) ──────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_PRIMARY_MODEL=claude-haiku-4-5
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-5
GLOBAL_ANTHROPIC_MONTHLY_TOKEN_CAP=200000000

# ─── Sarvam AI (STT for te-IN, kn-IN, ta-IN) ─────────────────────────
# te/kn/ta are dormant: the language picker only offers en-IN and hi-IN, so
# Sarvam is reached only by legacy vendor rows. Safe to leave unset.
SARVAM_API_KEY=...
# Optional override; code default is saaras:v3 (saaras:v2 is deprecated):
# SARVAM_STT_MODEL=saaras:v3
GLOBAL_SARVAM_MONTHLY_MINUTE_CAP=100000

# ─── OpenAI STT (first server-side provider for hi-IN, en-IN) ────────
# The browser's Web Speech handles en/hi by default; this is used only when
# NEXT_PUBLIC_VOICE_FALLBACK_ENABLED=true sends them to /api/ai/transcribe.
# Get from platform.openai.com → API Keys. Format: sk-...
# Used by lib/openai-stt.ts via gpt-4o-mini-transcribe.
# IMPORTANT: Zero-Data-Retention (ZDR) MUST be active on this org before
# any vendor traffic flows. Email tos@openai.com to request.
# NEVER paste this key into chat, commits, or screenshots.
OPENAI_API_KEY=sk-...
# Optional override — only set if OpenAI renames the model:
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Per-platform global cap; tune to your monthly budget:
GLOBAL_OPENAI_STT_MONTHLY_MINUTE_CAP=50000

# ─── Groq STT (second hop for ALL languages) ─────────────────────────
# Get from console.groq.com → API Keys. Format: gsk_...
# Used by lib/groq-stt.ts via whisper-large-v3-turbo.
# Cascades: en/hi OpenAI → Groq → Whisper; te/kn/ta Sarvam → Groq → Whisper.
# Each hop has its own circuit breaker; unconfigured providers are skipped.
# IMPORTANT: Groq runs on US infrastructure with no public ZDR tier;
# verify a DPDP-compliant agreement exists before flipping this on.
# NEVER paste this key into chat, commits, or screenshots.
GROQ_API_KEY=gsk_...
# Optional override:
# GROQ_STT_MODEL=whisper-large-v3-turbo
# Per-platform global cap (~$130 / mo at 200k min × $0.000667 / min):
GLOBAL_GROQ_STT_MONTHLY_MINUTE_CAP=200000

# ─── Self-hosted Whisper STT (last-resort ASR on Fly) ────────────────
# Deploy services/whisper-stt — see services/whisper-stt/README.md.
# Omitted from cascade when unset. Same secret on Vercel + Fly app.
# WHISPER_STT_SECRET must be at least 16 characters; a shorter value silently
# drops Whisper from the cascade (lib/whisper-stt.ts whisperSttConfigured()).
WHISPER_STT_URL=
WHISPER_STT_SECRET=

# Public flag — when "true", hi-IN/en-IN voice orders skip Web Speech and
# route through the server cascade (OpenAI → Groq → Whisper, skipping any
# provider that isn't configured). Defaults off. /api/ai/transcribe is
# STARTER+ only and the client doesn't check the plan, so with this on,
# FREE vendors' en/hi voice requests get a 402 instead of using Web Speech.
NEXT_PUBLIC_VOICE_FALLBACK_ENABLED=false

# ─── Razorpay ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
# Platform subscription plan ids (test or live, matching the keys above).
# Create them with `npm run razorpay:create-plans -- --create`, which prints
# these lines. Amounts are base + 18% GST (lib/subscription.ts). Creating a
# subscription throws without them. RAZORPAY_PLAN_STARTER is the old name for
# the monthly plan and is still read as a fallback.
RAZORPAY_PLAN_STARTER_MONTHLY=plan_...
RAZORPAY_PLAN_STARTER_YEARLY=plan_...
# Only so a hand-made PRO subscription keeps renewing; PRO is not sold.
RAZORPAY_PLAN_PRO=plan_...

# Storefront online payments use each VENDOR's own Razorpay keys (money goes to
# the vendor, never through the platform). Their key secret + webhook secret are
# stored AES-256-GCM encrypted with this 32-byte key. Generate once per
# environment and never rotate without re-encrypting:  openssl rand -base64 32
# Unset → online payments are unavailable (settings card shows 503).
PAYMENT_KEYS_ENCRYPTION_KEY=

# ─── Web Push (new-order alerts, lib/push.ts) ────────────────────────
# Generate once: npx web-push generate-vapid-keys
# Unset → push is a silent no-op.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ─── Gupshup (WhatsApp) — dormant ─────────────────────────────────────
# POS receipts now go out as wa.me links from the vendor's own WhatsApp and
# need none of this. Only the unused Gupshup path reads these
# (lib/whatsapp.ts via workers/receipt.worker.ts). Safe to leave unset.
GUPSHUP_API_KEY=...
GUPSHUP_APP_NAME=awaazos
GUPSHUP_SOURCE_NUMBER=917XXXXXXXXX

# ─── AgentMail (transactional email) ──────────────────────────────────
# Powers password-reset delivery (lib/email.ts). Get both from the AgentMail
# dashboard: an API key, then the inbox that sends as your domain.
# When either is unset the reset flow still returns ok:true and logs
# "email.password_reset.unconfigured" — no email is sent and the vendor sees
# no error. Check that log line first if reset mails go missing.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Optional — only to point at a non-default API host:
# AGENTMAIL_API_BASE=https://api.agentmail.to/v0

# ─── Sentry (observability) ───────────────────────────────────────────
# Server DSN (API + workers)
SENTRY_DSN=
# Browser DSN (can be same as SENTRY_DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Optional tuning; defaults shown
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAY_SAMPLE_RATE=0
# Needed only if you want source-map upload in CI/deploy
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Redis ────────────────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL + TOKEN → Upstash HTTP client used by Vercel
# functions (rate limiting, idempotency, AI caps). Get from:
#   console.upstash.com → your database → REST API tab
# Works in all serverless/edge runtimes; no persistent TCP required.
UPSTASH_REDIS_REST_URL=https://<db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# REDIS_URL → ioredis TCP connection for BullMQ (lib/queues.ts). Workers on
# Fly consume; Vercel API routes enqueue (voice-parse-log telemetry, retention,
# dormant Gupshup receipts). Without it those enqueues fail; voice telemetry
# is dropped silently.
# On Vercel it must be a PUBLIC rediss:// endpoint — Fly *.internal hostnames
# are only reachable from inside Fly.
REDIS_URL=redis://localhost:6379

# ─── Vercel Blob (menu item photos) ──────────────────────────────────
# Auto-injected on Vercel deploys; set manually only for local dev.
BLOB_READ_WRITE_TOKEN=
# A second, PRIVATE store for buyers' UPI payment screenshots (PII: name, UPI
# ID, UTR). Connect it in Vercel with the env prefix PAYMENT_PROOF_BLOB.
# Unset → buyers don't see the screenshot field.
PAYMENT_PROOF_BLOB_READ_WRITE_TOKEN=

# ─── App ──────────────────────────────────────────────────────────────
# Also the origin baked into emailed password-reset links. Resolution order:
# AUTH_URL → NEXT_PUBLIC_APP_URL → https://$VERCEL_PROJECT_PRODUCTION_URL →
# http://localhost:3000. The request Host header is deliberately NOT trusted.
# Off Vercel (Docker, Fly) the third step doesn't exist, so with neither
# AUTH_URL nor this set, emailed links point at localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional pino level; defaults to "info" in production, "debug" otherwise.
# LOG_LEVEL=info

# Internal demo-store API (/api/internal/demo-stores, docs/INTERNAL_DEMO_STORES.md).
# Server-side only, at least 32 chars: `openssl rand -base64 48`. Unset = API off (401).
# INTERNAL_API_KEY=
# Internal account that owns demo stores until a prospect claims one.
# Created on first use with no password; set one through /forgot-password.
# DEMO_OWNER_EMAIL=demo-owner@example.com
